{
  "name": "stake-preflight",
  "version": "0.2.0",
  "description": "Pre-submission checks for Stake Engine games: plays your build against a mock RGS and reports what review tends to send back.",
  "keywords": [
    "stake",
    "stake-engine",
    "rgs",
    "slots",
    "igaming",
    "playwright",
    "e2e",
    "qa"
  ],
  "license": "MIT",
  "author": "egedev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egedev0/stake-preflight.git"
  },
  "bugs": "https://github.com/egedev0/stake-preflight/issues",
  "homepage": "https://github.com/egedev0/stake-preflight#readme",
  "type": "module",
  "bin": {
    "stake-preflight": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --test \"test/*.test.ts\"",
    "prepare": "npm run build",
    "demo": "tsc -p tsconfig.build.json && node dist/bin.js test/fixtures/game --math test/fixtures/math --out demo-report"
  },
  "dependencies": {
    "playwright-core": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
